# Copy to .env and change every value marked CHANGE.

# Nextcloud admin account. The backend uses this as its service account
# (owns /EventManagement and manages groups/users). CHANGE the password.
NEXTCLOUD_ADMIN_USER=ncadmin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE-ME-admin-password

# Nextcloud's own MariaDB (internal to Nextcloud; not our app data). CHANGE.
MYSQL_ROOT_PASSWORD=CHANGE-ME-root
MYSQL_PASSWORD=CHANGE-ME-db

# Signs login sessions. Use a long random string: openssl rand -hex 32
JWT_SECRET=CHANGE-ME-long-random

# Public hostnames Nextcloud will answer to (space separated).
NEXTCLOUD_TRUSTED_DOMAINS=localhost nextcloud

# Host ports
WEB_PORT=8081
NEXTCLOUD_PORT=8080

# Users allowed to create events (Nextcloud group). The admin above is always allowed.
CREATOR_GROUP=event-creators
